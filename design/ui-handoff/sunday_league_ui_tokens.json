      },
      "club_colour_mapping": {
        "primary_club_colour": "accent",
        "secondary_club_colour": "optional secondary accent for crest details only",
        "neutral_surfaces": "remain unchanged",
        "semantic_success_warning_danger": "must not be replaced by club colours"
      }
    }
  }
}